{
  "name": "HealthQueue Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 8080, 3000],
  "portsAttributes": {
    "8000": { "label": "HealthQueue API" },
    "8080": { "label": "Argo CD UI" },
    "3000": { "label": "Grafana" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "opentofu.vscode-opentofu",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ]
    }
  }
}
